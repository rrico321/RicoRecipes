# Rico Recipe — environment template
# Copy to .env.local (gitignored) or populate via `vercel env pull .env.local`
# from inside an app directory (e.g. apps/mcp) after running `vercel link --repo`.

# Database (Neon — wired in Plan 01-03 via Vercel Neon integration)
# DATABASE_URL=postgres://...
# DATABASE_URL_UNPOOLED=postgres://...

# Turborepo remote cache (set as GitHub Actions secrets in CI — see Plan 01-03)
# TURBO_TOKEN=
# TURBO_TEAM=
