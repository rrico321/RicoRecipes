engine-strict=true
auto-install-peers=true
# pnpm 10's verify-deps-before-run flags stub workspaces (zero deps, no local
# node_modules dir) as "out of sync" under Turbo's parallel exec — race-failing
# non-deterministically. Disable since per-stub deps are nil and Turbo handles
# graph integrity itself. Revisit if any stub gains real dependencies.
verify-deps-before-run=false
